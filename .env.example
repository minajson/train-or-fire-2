# Train or Fire — configuration
#
# With no .env at all the app runs on the in-process store with a JSON snapshot
# on disk, which is what a single facilitator on a single machine needs. Both
# variables below matter only in production.

# PRODUCTION SOURCE OF TRUTH.
# When set, the Postgres driver takes over from the local one. On any
# multi-instance host (Vercel included) this is required: without it every
# instance runs its own private, divergent copy of the room.
#
# Point this at the POOLED endpoint. Every warm instance holds its own pool,
# so on a cold burst — a room of phones voting the moment a decision opens —
# a direct endpoint runs out of connections and votes come back as 500s.
#
# Server-only. Never prefix this with NEXT_PUBLIC_.
# TRAIN_FIRE_DATABASE_URL=postgres://user:pass@host-pooler.example/db?sslmode=require

# OPTIONAL, and only useful in production: a session-mode (direct) URL used
# for one thing, a persistent LISTEN connection. A transaction pooler drops
# LISTEN silently, so it cannot live on the URL above. Leaving this unset is a
# supported configuration — the driver falls back to its revision poll, which
# is what guarantees delivery either way.
# TRAIN_FIRE_DATABASE_URL_DIRECT=postgres://user:pass@host.example/db?sslmode=require

# Optional Postgres tuning.
# TRAIN_FIRE_PG_POOL=3          # pooled connections per instance
# TRAIN_FIRE_PG_POLL_MS=300     # cross-instance revision poll interval

# CANONICAL PUBLIC ORIGIN — what the join QR encodes.
# Set this on the PRODUCTION environment only. Leave it unset locally (so the
# QR points at whatever address you opened the projector on) and unset on
# preview deployments (so each preview points at itself).
# NEXT_PUBLIC_APP_URL=https://your-production-domain

# Where the local driver writes its snapshot. Defaults to ./.data
# TRAIN_FIRE_DATA_DIR=./.data
